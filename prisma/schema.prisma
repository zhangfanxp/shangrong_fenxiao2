  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  courses            CourseAssignmentCourse[]
  users              CourseAssignmentUser[]
  assignments        CourseAssignment[]

  @@index([assignedAt, id])
}

// Snapshot IDs deliberately have no foreign key to live courses/users.
model CourseAssignmentCourse {
  id                         String                @id @default(cuid())
  batchId                    String
  batch                      CourseAssignmentBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  courseId                   String                @db.VarChar(191)
  courseRecordNoSnapshot     String                @db.VarChar(12)
  courseNameSnapshot         String                @db.VarChar(100)
  applicablePositionSnapshot String                @db.VarChar(100)
  coverR2StorageId           String?               @db.VarChar(191)
  coverObjectKey             String?               @db.VarChar(1024)
  coverOriginalName          String?               @db.VarChar(255)
  coverMimeType              String?               @db.VarChar(100)
  coverSizeBytes             Int?
  coverDataUrl               String?               @db.LongText
  createdAt                  DateTime              @default(now())

  @@unique([batchId, courseId])
  @@index([courseId])
}

model CourseAssignmentUser {
  id               String                      @id @default(cuid())
  batchId          String
  batch            CourseAssignmentBatch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  userId           String                      @db.VarChar(191)
  usernameSnapshot String                      @db.VarChar(100)
  realNameSnapshot String                      @db.VarChar(100)
  roleSnapshot     String                      @db.VarChar(100)
  createdAt        DateTime                    @default(now())
  scopes           CourseAssignmentUserScope[]

  @@unique([batchId, userId])
  @@index([userId])
}

model CourseAssignmentUserScope {
  id               String               @id @default(cuid())
  assignmentUserId String
  assignmentUser   CourseAssignmentUser @relation(fields: [assignmentUserId], references: [id], onDelete: Cascade)
  brandId          String               @db.VarChar(191)
  storeId          String               @db.VarChar(191)
  brandName        String               @db.VarChar(100)
  storeName        String               @db.VarChar(100)

  @@index([assignmentUserId])
  @@index([brandId, storeId])
}

model CourseAssignmentSequence {
  dateKey   String   @id @db.VarChar(8)
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
}

model CourseBrand {
  id         String @id @default(cuid())
  courseId   String
  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  brandCode  String @db.VarChar(100)
  brandLabel String @db.VarChar(100)

  @@unique([courseId, brandCode])
  @@index([brandCode, courseId])
}

model CourseLesson {
  id                 String                 @id @default(cuid())
  recordNo           String                 @unique @db.VarChar(12)
  courseId           String?
  course             Course?                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseDraftId      String?                @db.VarChar(36)
  courseDraft        CourseDraft?           @relation(fields: [courseDraftId], references: [id], onDelete: Cascade)
  chapterName        String                 @db.VarChar(30)
  chapterDescription String?                @db.VarChar(200)
  coverR2StorageId   String?                @db.VarChar(191)
  coverObjectKey     String?                @db.VarChar(1024)
  coverOriginalName  String?                @db.VarChar(255)
  coverMimeType      String?                @db.VarChar(100)
  coverSizeBytes     Int?
  coverDataUrl       String?                @db.LongText
  coursewareType     CoursewareType
  fileR2StorageId    String                 @db.VarChar(191)
  originalFileName   String                 @db.VarChar(255)
  fileObjectKey      String                 @db.VarChar(1024)
  fileSizeBytes      Int
  mimeType           String                 @db.VarChar(100)
  remark             String?                @db.VarChar(200)
  sortOrder          Int
  createdByUserId    String?                @db.VarChar(191)
  createdByName      String                 @db.VarChar(50)
  deletedAt          DateTime?
  version            Int                    @default(1)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  learningProgress   CourseLessonProgress[]

  @@unique([courseId, sortOrder])
  @@unique([courseDraftId, sortOrder])
  @@index([courseId, deletedAt, sortOrder])
  @@index([courseDraftId, deletedAt, sortOrder])
}

model CourseLearningProgress {
  id                      String    @id @default(cuid())
  courseId                String
  course                  Course    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  userId                  String    @db.VarChar(191)
  progress                Int       @default(0)
  firstLearnedAt          DateTime?
  lastLearnedAt           DateTime?
  learnerRealNameSnapshot String?   @db.VarChar(100)
  completedAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([courseId, userId])
  @@index([userId, createdAt])
}

model CourseLessonProgress {
  id              String       @id @default(cuid())
  lessonId        String
  lesson          CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  userId          String       @db.VarChar(191)
  progressSeconds Int          @default(0)
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([lessonId, userId])
  @@index([userId, createdAt])
}

model CourseSequence {
  dateKey   String   @id @db.VarChar(8)
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
}

// One actual lesson-page entry, not one user/lesson aggregate. Snapshot IDs have
// no live-course/user foreign key so historical visits survive later deletion.
model CourseLessonVisit {
  id                      String    @id @db.VarChar(36)
  userId                  String    @db.VarChar(191)
  courseId                String    @db.VarChar(191)
  lessonId                String?   @db.VarChar(191)
  channel                 String    @db.VarChar(20)
  courseRecordNoSnapshot  String    @db.VarChar(12)
  courseNameSnapshot      String    @db.VarChar(100)
  chapterNameSnapshot     String    @db.VarChar(100)
  learnerRealNameSnapshot String    @db.VarChar(100)
  status                  String    @default("ACTIVE") @db.VarChar(20)
  startedAt               DateTime?
  lastActiveAt            DateTime?
  endedAt                 DateTime?
  endReason               String?   @db.VarChar(30)
  legacySourceKey         String?   @unique @db.VarChar(191)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([courseId, userId, createdAt, id])
  @@index([courseId, createdAt, id])
  @@index([lessonId, userId])
  @@index([status, lastActiveAt])
}

model CourseLessonSequence {
  dateKey   String   @id @db.VarChar(8)
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
}

model Notification {
  id              String                  @id @default(cuid())
  recordNo        String                  @unique @db.VarChar(12)
  clientRequestId String                  @unique @db.VarChar(64)
  title           String                  @db.VarChar(30)
  content         String                  @db.LongText
  type            NotificationType        @default(GENERAL)
  publishMode     NotificationPublishMode @default(SCHEDULED)
  releaseDate     DateTime                @db.Date
  releaseAt       DateTime
  publisherName   String                  @db.VarChar(10)
  showAfterLogin  Boolean                 @default(false)
  status          NotificationStatus      @default(PENDING)
  createdByUserId String?
  createdBy       User?                   @relation("NotificationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByName   String                  @db.VarChar(30)
  publishedAt     DateTime?
  stoppedAt       DateTime?
  stoppedByUserId String?
  stoppedByName   String?                 @db.VarChar(30)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  recipients      NotificationRecipient[]
  meeting         Meeting?

  @@index([status, releaseAt])
  @@index([createdByUserId, createdAt])
}

model NotificationRecipient {
  id               String       @id @default(cuid())
  notificationId   String
  notification     Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?        @relation("NotificationRecipientUser", fields: [userId], references: [id], onDelete: SetNull)
  usernameSnapshot String       @db.VarChar(30)
  realNameSnapshot String       @db.VarChar(30)
  roleSnapshot     String       @db.VarChar(50)
  readAt           DateTime?
  acknowledgedAt   DateTime?
  createdAt        DateTime     @default(now())

  @@unique([notificationId, userId])
  @@index([userId, notificationId])
  @@index([notificationId, readAt])
  @@index([userId, acknowledgedAt])
}

model NotificationSequence {
  dateKey   String   @id @db.VarChar(8)
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
}

model Meeting {
  id                          String                  @id @default(cuid())
  recordNo                    String                  @unique @db.VarChar(12)
  type                        MeetingType
  meetingMonth                DateTime                @db.Date
  notificationId              String                  @unique
  notification                Notification            @relation(fields: [notificationId], references: [id], onDelete: Restrict)
  notificationContentSnapshot String?                 @db.VarChar(500)
  notificationReleaseDate     DateTime?               @db.Date
  publisherNameSnapshot       String?                 @db.VarChar(10)
  attendanceStatus            MeetingAttendanceStatus @default(UNSIGNED)
  attendanceVersion           Int                     @default(0)
  checkedInByUserId           String?
  checkedInByName             String?                 @db.VarChar(30)
  checkedInAt                 DateTime?
  createdByUserId             String?
  createdBy                   User?                   @relation("MeetingCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByName               String                  @db.VarChar(30)
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  participants                MeetingParticipant[]

  @@index([type, meetingMonth])
  @@index([type, attendanceStatus])
  @@index([createdByUserId, createdAt])
}

model MeetingParticipant {
  id               String    @id @default(cuid())
  meetingId        String
  meeting          Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?     @relation("MeetingParticipantUser", fields: [userId], references: [id], onDelete: SetNull)
  usernameSnapshot String    @db.VarChar(30)
  realNameSnapshot String    @db.VarChar(30)
  roleSnapshot     String    @db.VarChar(50)
  attendedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@unique([meetingId, userId])
  @@index([userId, meetingId])
  @@index([meetingId, attendedAt])
}

model R2StorageConfig {
  id                       String               @id @default(cuid())
  recordNo                 String               @unique @db.VarChar(12)
  name                     String               @db.VarChar(20)
  accountId                String               @db.VarChar(50)
  accessKeyIdEncrypted     String               @db.Text
  secretAccessKeyEncrypted String               @db.Text
  bucketName               String               @db.VarChar(50)
  endpoint                 String               @db.VarChar(150)
  signedUrlExpireSeconds   Int                  @default(300)
  status                   RecordStatus         @default(ENABLED)
  version                  Int                  @default(1)
  createdByUserId          String?
  createdBy                User?                @relation("R2StorageCreator", fields: [createdByUserId], references: [id])
  references               R2StorageReference[]
  tests                    R2StorageTest[]
  tasks                    Task[]               @relation("TaskR2Storage")
  assessments              Assessment[]         @relation("AssessmentR2Storage")
  deletedAt                DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@index([accountId, bucketName])
  @@index([status])
  @@index([createdAt])
}

model R2StorageReference {
  id           String          @id @default(cuid())
  r2ConfigId   String
  r2Config     R2StorageConfig @relation(fields: [r2ConfigId], references: [id])
  businessType String          @db.VarChar(50)
  businessId   String          @db.VarChar(100)
  createdAt    DateTime        @default(now())

  @@unique([businessType, businessId])
  @@index([r2ConfigId])
}

model R2StorageTest {
  id              String          @id @default(cuid())
  r2ConfigId      String
  r2Config        R2StorageConfig @relation(fields: [r2ConfigId], references: [id])
  fileName        String          @db.VarChar(15)
  status          R2TestStatus    @default(PENDING)
  errorCode       String?         @db.VarChar(50)
  createdByUserId String?
  createdBy       User?           @relation("R2StorageTestCreator", fields: [createdByUserId], references: [id])
  createdAt       DateTime        @default(now())
  completedAt     DateTime?

  @@unique([r2ConfigId, fileName])
  @@index([createdAt])
}

model DatabaseBackupSetting {
  id              String   @id @db.VarChar(32)
  r2StorageId     String   @db.VarChar(191)
  enabled         Boolean  @default(false)
  frequency       String   @default("DAILY") @db.VarChar(10)
  weekdays        Json?
  executionTimes  Json
  updatedByUserId String?  @db.VarChar(191)
  updatedByName   String?  @db.VarChar(50)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([r2StorageId])
}

model DatabaseBackupFile {
  id                    String    @id @default(cuid())
  fileName              String    @unique @db.VarChar(255)
  r2StorageId           String    @db.VarChar(191)
  r2StorageNameSnapshot String    @db.VarChar(50)
  bucketNameSnapshot    String    @db.VarChar(63)
  objectKey             String    @unique @db.VarChar(500)
  backupType            String    @db.VarChar(20)
  status                String    @db.VarChar(20)
  sizeBytes             BigInt    @default(0)
  checksumSha256        String?   @db.VarChar(64)
  durationSeconds       Int?
  scheduleKey           String?   @unique @db.VarChar(20)
  activeLockKey         String?   @unique @db.VarChar(32)
  errorMessage          String?   @db.Text
  createdByUserId       String?   @db.VarChar(191)
  createdByName         String    @db.VarChar(50)
  startedAt             DateTime  @default(now())
  completedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status, startedAt])
  @@index([r2StorageId])
  @@index([backupType, startedAt])
}

/// Records one-time database changes applied by the local deployment assistant.
/// Future deploy migrations must use a stable id and immutable checksum.
model DeploymentMigration {
  id          String    @id @db.VarChar(100)
  checksum    String    @db.VarChar(64)
  appVersion  String    @db.VarChar(30)
  description String?   @db.VarChar(200)
  status      String    @default("SUCCESS") @db.VarChar(20)
  startedAt   DateTime  @default(now())
  appliedAt   DateTime?
  error       String?   @db.Text

  @@index([status, startedAt])
}

// 仅在新巡检正式提交时创建；历史巡检不回填。
model InspectionRectification {
  id                 String                         @id @default(cuid())
  recordNo           String                         @unique @db.VarChar(20)
  reviewItemId       String                         @unique
  reviewItem         LeadH5ReviewItem               @relation(fields: [reviewItemId], references: [id], onDelete: Cascade)
  status             String                         @default("PENDING") @db.VarChar(24)
  noActionReason     String?                        @db.Text
  noActionAt         DateTime?
  noActionByName     String?                        @db.VarChar(100)
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  rounds             InspectionRectificationRound[]

  @@index([status, createdAt])
}

model InspectionRectificationRound {
  id                    String                   @id @default(cuid())
  rectificationId       String
  rectification         InspectionRectification  @relation(fields: [rectificationId], references: [id], onDelete: Restrict)
  roundNumber           Int
  generatedAt           DateTime                 @default(now())
  deadlineHours         Int
  dueAt                 DateTime
  responsibleUserId     String                   @db.VarChar(191)
  responsibleName       String                   @db.VarChar(100)
  requirement           String                   @db.VarChar(100)
  ccRecipients          Json
  taskRecordId          String                   @unique
  taskRecord            TaskRecord               @relation(fields: [taskRecordId], references: [id], onDelete: Restrict)
  submittedAt           DateTime?
  submissionDescription String?                  @db.Text
  acceptedAt            DateTime?
  acceptanceResult      String?                  @db.VarChar(20)
  acceptedByUserId      String?                  @db.VarChar(191)
  acceptedByName        String?                  @db.VarChar(100)
  rejectionReason       String?                  @db.Text

  @@unique([rectificationId, roundNumber])
  @@index([responsibleUserId])
  @@index([submittedAt, dueAt])
}
