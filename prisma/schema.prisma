generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ENABLED
  DISABLED
}

enum UserType {
  SYSTEM
  CUSTOM
}

enum ContractStatus {
  PENDING
  ACTIVE
  EXPIRING
  TERMINATED
  EXPIRED
}

enum StoreOperationStatus {
  PREPARING
  TRIAL
  OPENING
  TERMINATING
  SUSPENDED
  CLOSED
}

enum CooperationType {
  DIRECT
  FRANCHISE
}

enum TaskType {
  DAILY
  WEEKLY
  MONTHLY
  TEMPORARY
}

enum TaskRecordStatus {
  PENDING
  COMPLETED
  OVERDUE
}

enum AssessmentScoreMode {
  BINARY
  CUSTOM_SCORE
}

enum R2TestStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PersonnelStatus {
  ACTIVE
  RESIGNED
}

enum SocialSecurityStatus {
  INSURED
  AGREEMENT
}

enum PlatformAccess {
  YES
  NO
}

enum NotificationStatus {
  PENDING
  PUBLISHED
  STOPPED
  FAILED
}

enum NotificationType {
  GENERAL
  MID_MONTH_OFFLINE_MEETING
  MONTHLY_ONLINE_MEETING
}

enum NotificationPublishMode {
  SCHEDULED
  IMMEDIATE
}

enum MeetingType {
  MID_MONTH_OFFLINE
  MONTHLY_ONLINE
}

enum MeetingAttendanceStatus {
  UNSIGNED
  SIGNED
}

model Role {
  id            String       @id @default(cuid())
  code          String       @unique
  name          String       @unique
  type          String       @default("SYSTEM")
  status        RecordStatus @default(ENABLED)
  permissions   Json
  users         User[]
  assignedTasks Task[]       @relation("TaskExecutorRole")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model User {
  id                        String                   @id @default(cuid())
  username                  String                   @unique
  passwordHash              String
  realName                  String
  phone                     String?
  tags                      String?                  @db.VarChar(200)
  leadH5BrandIds            Json?
  leadH5StoreIds            Json?
  type                      UserType                 @default(CUSTOM)
  status                    RecordStatus             @default(ENABLED)
  roleId                    String
  role                      Role                     @relation(fields: [roleId], references: [id])
  createdByUserId           String?
  createdBy                 User?                    @relation("UserCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdUsers              User[]                   @relation("UserCreator")
  lastLoginAt               DateTime?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  logs                      OperationLog[]
  createdTasks              Task[]                   @relation("TaskCreator")
  createdAssessments        Assessment[]             @relation("AssessmentCreator")
  createdResearchTemplates  ResearchTemplate[]       @relation("ResearchTemplateCreator")
  createdR2StorageConfigs   R2StorageConfig[]        @relation("R2StorageCreator")
  r2StorageTests            R2StorageTest[]          @relation("R2StorageTestCreator")
  personnelProfile          Personnel?               @relation("PersonnelPlatformUser")
  createdPersonnel          Personnel[]              @relation("PersonnelCreator")
  salaryAdjustments         SalaryHistory[]          @relation("SalaryOperator")
  positionTransfers         PositionHistory[]        @relation("PositionOperator")
  leadH5Reviews             LeadH5Review[]           @relation("LeadH5Reviewer")
  leadH5ResearchRecords     ResearchTemplateRecord[] @relation("LeadH5ResearchSubmitter")
  assignedTaskRecords       TaskRecord[]             @relation("TaskRecordAssignee")
  taskSubmissions           TaskSubmission[]         @relation("TaskSubmissionUser")
  taskAttachments           TaskAttachment[]         @relation("TaskAttachmentUploader")
  createdNotifications      Notification[]           @relation("NotificationCreator")
  notificationRecipients    NotificationRecipient[]  @relation("NotificationRecipientUser")
  createdMeetings           Meeting[]                @relation("MeetingCreator")
  meetingParticipants       MeetingParticipant[]     @relation("MeetingParticipantUser")
  createdDailyLearningPlans DailyLearningPlan[]      @relation("DailyLearningPlanCreator")
  dailyLearningAssignments  DailyLearningAssignee[]  @relation("DailyLearningAssigneeUser")
  dailyLearningProgress     DailyLearningProgress[]  @relation("DailyLearningProgressUser")

  @@index([createdByUserId])
}

model Assessment {
  id               String                 @id @default(cuid())
  recordNo         String                 @unique
  name             String
  scoreMode        AssessmentScoreMode    @default(BINARY)
  configFileName   String                 @unique
  applicableBrands Json?
  detailText       String                 @db.LongText
  sectionCount     Int
  subsectionCount  Int
  itemCount        Int
  totalScore       Decimal                @db.Decimal(10, 1)
  remark           String?                @db.VarChar(50)
  status           RecordStatus           @default(ENABLED)
  configVersion    Int                    @default(1)
  createdByUserId  String?
  createdBy        User?                  @relation("AssessmentCreator", fields: [createdByUserId], references: [id])
  deletedAt        DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  records          AssessmentRecord[]
  leadH5Reviews    LeadH5Review[]
  brandScopes      AssessmentBrandScope[]

  @@index([createdAt])
  @@index([status])
}

model AssessmentBrandScope {
  id             String     @id @default(cuid())
  assessmentId   String
  assessment     Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  brandValue     String     @db.VarChar(100)
  assessmentType String     @db.VarChar(100)
  activeKey      String?    @unique @db.VarChar(64)

  @@unique([assessmentId, brandValue])
  @@index([brandValue, assessmentType])
}

model AssessmentRecord {
  id               String     @id @default(cuid())
  assessmentId     String
  assessment       Assessment @relation(fields: [assessmentId], references: [id])
  configVersion    Int
  configSnapshot   Json
  scoreSnapshot    Json?
  actualTotalScore Decimal?   @db.Decimal(10, 1)
  createdAt        DateTime   @default(now())

  @@index([assessmentId])
}

model ResearchTemplate {
  id              String                   @id @default(cuid())
  recordNo        String                   @unique @db.VarChar(12)
  templateType    String                   @db.VarChar(100)
  configFileName  String                   @unique @db.VarChar(25)
  detailText      String                   @db.LongText
  itemCount       Int
  remark          String?                  @db.VarChar(50)
  status          RecordStatus             @default(ENABLED)
  configVersion   Int                      @default(1)
  createdByUserId String?
  createdBy       User?                    @relation("ResearchTemplateCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByName   String                   @db.VarChar(50)
  deletedAt       DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  brandScopes     ResearchTemplateBrand[]
  records         ResearchTemplateRecord[]

  @@index([templateType])
  @@index([status])
  @@index([createdAt])
}

model ResearchTemplateBrand {
  id                 String           @id @default(cuid())
  researchTemplateId String
  researchTemplate   ResearchTemplate @relation(fields: [researchTemplateId], references: [id], onDelete: Cascade)
  brandValue         String           @db.VarChar(100)

  @@unique([researchTemplateId, brandValue])
  @@index([brandValue])
}

model ResearchTemplateRecord {
  id                       String           @id @default(cuid())
  recordNo                 String           @unique @db.VarChar(12)
  researchMonth            String           @db.VarChar(7)
  templateType             String           @db.VarChar(100)
  status                   String           @default("SUBMITTED") @db.VarChar(20)
  storeId                  String
  store                    Store            @relation(fields: [storeId], references: [id])
  storeNameSnapshot        String           @db.VarChar(100)
  brandId                  String
  brandNameSnapshot        String           @db.VarChar(100)
  storeManagerNameSnapshot String?          @db.VarChar(50)
  submittedByUserId        String
  submittedBy              User             @relation("LeadH5ResearchSubmitter", fields: [submittedByUserId], references: [id])
  submittedUsername        String           @db.VarChar(50)
  supervisorRealName       String           @db.VarChar(50)
  researchTemplateId       String
  researchTemplate         ResearchTemplate @relation(fields: [researchTemplateId], references: [id])
  researchTemplateRecordNo String           @db.VarChar(12)
  configVersion            Int
  configSnapshot           Json
  resultSnapshot           Json
  submittedAt              DateTime         @db.DateTime(0)
  createdAt                DateTime         @default(now())

  @@unique([storeId, researchMonth, templateType])
  @@index([researchTemplateId])
  @@index([researchMonth, templateType])
  @@index([submittedByUserId])
}

model LeadH5ResearchSequence {
  dateKey   String   @id @db.VarChar(8)
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
}

model Brand {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String       @unique
  status    RecordStatus @default(ENABLED)
  contracts Contract[]
  stores    Store[]
  taskLinks TaskBrand[]
  createdAt DateTime     @default(now())
}

model Contract {
  id                String           @id @default(cuid())
  recordNo          String           @unique
  brandId           String
  brand             Brand            @relation(fields: [brandId], references: [id])
  storeName         String
  status            ContractStatus   @default(PENDING)
  archiveBox        String?
  trialOpenDate     DateTime?
  cooperationType   CooperationType
  contactName       String?
  contactPhone      String?
  ownerName         String
  ownerPhone        String?
  ownerIdNumber     String?
  province          String?
  city              String?
  district          String?
  address           String?
  cooperationFee    Decimal          @default(0) @db.Decimal(12, 2)
  brandFee          Decimal          @default(0) @db.Decimal(12, 2)
  financeServiceFee Decimal          @default(0) @db.Decimal(12, 2)
  designFee         Decimal          @default(0) @db.Decimal(12, 2)
  deposit           Decimal          @default(0) @db.Decimal(12, 2)
  depositRecipient  String?
  refundedDeposit   Decimal          @default(0) @db.Decimal(12, 2)
  rebateType        String?
  rebatePerson      String?
  rebateAmount      Decimal          @default(0) @db.Decimal(12, 2)
  startDate         DateTime
  endDate           DateTime
  remark            String?          @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  store             Store?
  rebates           ContractRebate[]
}

model ContractRebate {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  type       String
  person     String
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([contractId])
}

model Store {
  id                    String                   @id @default(cuid())
  recordNo              String                   @unique
  contractId            String?                  @unique
  contract              Contract?                @relation(fields: [contractId], references: [id])
  brandId               String
  brand                 Brand                    @relation(fields: [brandId], references: [id])
  name                  String
  operationStatus       StoreOperationStatus     @default(PREPARING)
  region                String?
  supervisorName        String?
  province              String?
  city                  String?
  district              String?
  address               String?
  cooperationType       CooperationType
  startDate             DateTime?
  endDate               DateTime?
  businessDistrict      String?
  locationType          String?
  trialOpenDate         DateTime?
  formalOpenDate        DateTime?
  managerName           String?
  chefName              String?
  ownerName             String?
  ownerPhone            String?
  ownerIdNumber         String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  personnel             Personnel[]
  leadH5Reviews         LeadH5Review[]
  leadH5ResearchRecords ResearchTemplateRecord[]
  taskRecords           TaskRecord[]
  taskSubmissions       TaskSubmission[]
}

model LeadH5Review {
  id                            String             @id @default(cuid())
  recordNo                      String             @unique @db.VarChar(12)
  reviewType                    String             @db.VarChar(50)
  reviewMonth                   String             @db.VarChar(7)
  storeId                       String
  store                         Store              @relation(fields: [storeId], references: [id])
  storeNameSnapshot             String             @db.VarChar(100)
  brandId                       String
  brandNameSnapshot             String             @db.VarChar(100)
  responsiblePersonNameSnapshot String?            @db.VarChar(50)
  responsiblePersonType         String?            @db.VarChar(20)
  reviewerUserId                String
  reviewer                      User               @relation("LeadH5Reviewer", fields: [reviewerUserId], references: [id])
  reviewerUsername              String             @db.VarChar(50)
  reviewerRealName              String             @db.VarChar(50)
  assessmentSupervisor          String             @db.VarChar(50)
  assessmentDate                DateTime           @db.DateTime(0)
  assessmentId                  String
  assessment                    Assessment         @relation(fields: [assessmentId], references: [id])
  assessmentName                String             @db.VarChar(100)
  assessmentVersion             Int
  configSnapshot                Json
  maxScore                      Decimal            @db.Decimal(10, 1)
  actualScore                   Decimal            @db.Decimal(10, 1)
  submittedAt                   DateTime           @default(now())
  createdAt                     DateTime           @default(now())
  items                         LeadH5ReviewItem[]

  @@unique([storeId, reviewMonth, reviewType])
  @@index([reviewMonth, reviewType])
  @@index([reviewerUserId])
  @@index([assessmentId])
}

model LeadH5ReviewItem {
  id              String       @id @default(cuid())
  reviewId        String
  review          LeadH5Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  itemKey         String       @db.VarChar(100)
  sectionName     String       @db.VarChar(100)
  subsectionName  String       @db.VarChar(100)
  itemDescription String       @db.Text
  maxScore        Decimal      @db.Decimal(10, 1)
  result          String       @db.VarChar(20)
  actualScore     Decimal      @db.Decimal(10, 1)
  sortOrder       Int

  @@unique([reviewId, itemKey])
  @@index([reviewId, sortOrder])
}

model LeadH5ReviewSequence {
  dateKey   String   @id @db.VarChar(8)
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
}

model PersonnelSequence {
  dateKey   String   @id @db.VarChar(8)
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
}

model Personnel {
  id                    String               @id @default(cuid())
  recordNo              String               @unique @db.VarChar(12)
  name                  String               @db.VarChar(8)
  phone                 String               @db.VarChar(11)
  idNumber              String               @unique @db.VarChar(18)
  birthday              String?              @db.VarChar(5)
  status                PersonnelStatus      @default(ACTIVE)
  hireDate              DateTime
  positionLevel         String               @db.VarChar(50)
  organization          String               @db.VarChar(30)
  storeId               String
  store                 Store                @relation(fields: [storeId], references: [id])
  resignationDate       DateTime?
  resignationReason     String?              @db.VarChar(200)
  contractSignDate      DateTime
  contractYears         Int?
  contractExpiryDate    DateTime
  homeAddress           String               @db.VarChar(50)
  currentAddress        String               @db.VarChar(50)
  supplementaryMaterial String?              @db.VarChar(50)
  baseSalary            Decimal              @db.Decimal(12, 2)
  laborCost             Decimal              @default(0) @db.Decimal(12, 2)
  workdayHours          Decimal?             @db.Decimal(5, 2)
  socialSecurity        SocialSecurityStatus
  platformAccess        PlatformAccess?
  platformUserId        String?              @unique
  platformUser          User?                @relation("PersonnelPlatformUser", fields: [platformUserId], references: [id])
  remark                String?              @db.VarChar(50)
  version               Int                  @default(1)
  createdByUserId       String?
  createdBy             User?                @relation("PersonnelCreator", fields: [createdByUserId], references: [id])
  deletedAt             DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  salaryHistory         SalaryHistory[]
  positionHistory       PositionHistory[]

  @@index([status, deletedAt])
  @@index([hireDate])
  @@index([organization])
  @@index([storeId])
}

model SalaryHistory {
  id            String    @id @default(cuid())
  personnelId   String
  personnel     Personnel @relation(fields: [personnelId], references: [id])
  oldSalary     Decimal   @db.Decimal(12, 2)
  newSalary     Decimal   @db.Decimal(12, 2)
  effectiveDate DateTime
  reason        String    @db.VarChar(200)
  operatorId    String?
  operator      User?     @relation("SalaryOperator", fields: [operatorId], references: [id])
  operatorName  String    @db.VarChar(30)
  createdAt     DateTime  @default(now())

  @@index([personnelId, effectiveDate])
}

model PositionHistory {
  id               String    @id @default(cuid())
  personnelId      String
  personnel        Personnel @relation(fields: [personnelId], references: [id])
  oldOrganization  String    @db.VarChar(30)
  newOrganization  String    @db.VarChar(30)
  oldStoreName     String    @db.VarChar(60)
  newStoreName     String    @db.VarChar(60)
  oldPositionLevel String    @db.VarChar(50)
  newPositionLevel String    @db.VarChar(50)
  effectiveDate    DateTime
  reason           String    @db.VarChar(200)
  operatorId       String?
  operator         User?     @relation("PositionOperator", fields: [operatorId], references: [id])
  operatorName     String    @db.VarChar(30)
  createdAt        DateTime  @default(now())

  @@index([personnelId, effectiveDate])
}

model Task {
  id                    String           @id @default(cuid())
  recordNo              String?          @unique
  title                 String
  type                  TaskType
  status                RecordStatus     @default(ENABLED)
  description           String?          @db.Text
  executorRoleId        String?
  executorRole          Role?            @relation("TaskExecutorRole", fields: [executorRoleId], references: [id])
  includeCompletionRate Boolean          @default(true)
  executionDays         Json?
  weeklyExecutionDay    String?          @db.VarChar(3)
  monthlyExecutionDay   String?          @db.VarChar(10)
  deadlineDayOffset     Int              @default(0)
  deadlineTime          String           @default("23:59") @db.VarChar(5)
  configFileName        String?          @unique
  submitItems           Json?
  configVersion         Int              @default(1)
  r2StorageId           String?
  r2Storage             R2StorageConfig? @relation("TaskR2Storage", fields: [r2StorageId], references: [id])
  createdByUserId       String?
  createdBy             User?            @relation("TaskCreator", fields: [createdByUserId], references: [id])
  deletedAt             DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @default(now()) @updatedAt
  records               TaskRecord[]
  brands                TaskBrand[]

  @@index([createdAt])
  @@index([executorRoleId])
  @@index([r2StorageId])
}

model TaskBrand {
  taskId  String
  brandId String
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  brand   Brand  @relation(fields: [brandId], references: [id])

  @@id([taskId, brandId])
}

model TaskRecord {
  id                       String           @id @default(cuid())
  recordNo                 String?          @unique @db.VarChar(24)
  taskId                   String
  task                     Task             @relation(fields: [taskId], references: [id])
  taskNameSnapshot         String?          @db.VarChar(100)
  taskType                 TaskType?
  storeId                  String?
  store                    Store?           @relation(fields: [storeId], references: [id])
  storeNameSnapshot        String?          @db.VarChar(100)
  brandIdSnapshot          String?          @db.VarChar(191)
  brandNameSnapshot        String?          @db.VarChar(100)
  assignedUserId           String?
  assignedUser             User?            @relation("TaskRecordAssignee", fields: [assignedUserId], references: [id])
  assignedUserNameSnapshot String?          @db.VarChar(50)
  assignedRoleIdSnapshot   String?          @db.VarChar(191)
  assignedRoleNameSnapshot String?          @db.VarChar(50)
  executionDate            DateTime?        @db.Date
  effectiveStartAt         DateTime?
  effectiveEndAt           DateTime?
  includeCompletionRate    Boolean?         @default(true)
  status                   TaskRecordStatus @default(PENDING)
  dueDate                  DateTime
  triggeredAt              DateTime         @default(now())
  completedAt              DateTime?
  configVersion            Int?
  configSnapshot           Json?
  submission               Json?
  formalSubmission         TaskSubmission?
  attachments              TaskAttachment[]
  createdAt                DateTime         @default(now())

  @@unique([taskId, assignedUserId, storeId, executionDate])
  @@index([assignedUserId, executionDate, status])
  @@index([storeId, executionDate])
  @@index([status, dueDate])
}

model TaskSchedulerRun {
  id            String    @id @default(cuid())
  executionDate DateTime  @unique @db.Date
  scheduledTime String    @db.VarChar(5)
  status        String    @db.VarChar(20)
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  result        Json?
  error         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, startedAt])
}

model TaskSubmission {
  id                   String               @id @default(cuid())
  recordNo             String               @unique @db.VarChar(14)
  taskRecordId         String               @unique
  taskRecord           TaskRecord           @relation(fields: [taskRecordId], references: [id])
  taskIdSnapshot       String               @db.VarChar(191)
  taskSettingRecordNo  String?              @db.VarChar(24)
  taskNameSnapshot     String               @db.VarChar(100)
  taskType             TaskType
  storeId              String
  store                Store                @relation(fields: [storeId], references: [id])
  storeNameSnapshot    String               @db.VarChar(100)
  brandIdSnapshot      String               @db.VarChar(191)
  brandNameSnapshot    String               @db.VarChar(100)
  userId               String
  user                 User                 @relation("TaskSubmissionUser", fields: [userId], references: [id])
  userRealNameSnapshot String               @db.VarChar(50)
  executionDate        DateTime             @db.Date
  configVersion        Int
  configSnapshot       Json
  submittedAt          DateTime             @default(now())
  createdAt            DateTime             @default(now())
  items                TaskSubmissionItem[]

  @@index([userId, submittedAt])
  @@index([storeId, executionDate])
}

model TaskSubmissionSequence {
  dateKey   String   @id @db.VarChar(8)
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
}

model TaskSubmissionItem {
  id                  String         @id @default(cuid())
  submissionId        String
  submission          TaskSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  itemName            String         @db.VarChar(100)
  componentType       String         @db.VarChar(20)
  dataType            String?        @db.VarChar(20)
  description         String         @db.Text
  required            Boolean
  weight              Int
  value               String?        @db.Text
  attachmentObjectKey String?        @db.VarChar(512)
  attachmentName      String?        @db.VarChar(255)
  attachmentMimeType  String?        @db.VarChar(100)
  r2StorageId         String?        @db.VarChar(191)
  sortOrder           Int
  submittedAt         DateTime       @default(now())

  @@unique([submissionId, sortOrder])
  @@index([submissionId])
}

model TaskAttachment {
  id             String     @id @default(cuid())
  taskRecordId   String
  taskRecord     TaskRecord @relation(fields: [taskRecordId], references: [id])
  itemIndex      Int
  uploaderUserId String
  uploader       User       @relation("TaskAttachmentUploader", fields: [uploaderUserId], references: [id])
  r2StorageId    String     @db.VarChar(191)
  objectKey      String     @unique @db.VarChar(512)
  originalName   String     @db.VarChar(255)
  mimeType       String     @db.VarChar(100)
  size           Int
  consumedAt     DateTime?
  createdAt      DateTime   @default(now())

  @@index([taskRecordId, itemIndex, uploaderUserId])
}

model DictionaryItem {
  id        String       @id @default(cuid())
  type      String
  label     String
  value     String
  sort      Int          @default(0)
  status    RecordStatus @default(ENABLED)
  createdAt DateTime     @default(now())

  @@unique([type, value])
}

model DataDictionary {
  id        String       @id @default(cuid())
  recordNo  String       @unique @db.VarChar(12)
  name      String       @unique @db.VarChar(10)
  code      String       @unique @db.VarChar(30)
  fileName  String       @unique @db.VarChar(35)
  remark    String?      @db.VarChar(200)
  status    RecordStatus @default(ENABLED)
  version   Int          @default(1)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([createdAt])
  @@index([status])
}

model OperationLog {
  id            String   @id @default(cuid())
  recordNo      String?  @unique @db.VarChar(14)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  username      String?  @db.VarChar(50)
  client        String?  @db.VarChar(30)
  page          String
  action        String
  result        String
  detail        String?  @db.Text
  ip            String?  @db.VarChar(45)
  operationDate String?  @db.VarChar(10)
  operationTime String?  @db.VarChar(8)
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([operationDate, operationTime])
  @@index([username])
  @@index([client])
  @@index([page])
  @@index([action])
  @@index([result])
  @@index([ip])
}

model OperationLogSequence {
  dateKey   String   @id @db.VarChar(8)
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
}

model DailyLearningPlan {
  id               String                  @id @default(cuid())
  recordNo         String                  @unique @db.VarChar(12)
  isoYear          Int
  isoWeek          Int
  studentTag       String                  @db.VarChar(100)
  activeKey        String?                 @unique @db.VarChar(220)
  weekStartAt      DateTime
  mondayContent    String?                 @db.Text
  tuesdayContent   String?                 @db.Text
  wednesdayContent String?                 @db.Text
  thursdayContent  String?                 @db.Text
  fridayContent    String?                 @db.Text
  saturdayContent  String?                 @db.Text
  sundayContent    String?                 @db.Text
  learningDays     Int
  remark           String?                 @db.VarChar(100)
  version          Int                     @default(1)
  createdByUserId  String?
  createdBy        User?                   @relation("DailyLearningPlanCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByName    String                  @db.VarChar(50)
  deletedAt        DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  assignees        DailyLearningAssignee[]
  progress         DailyLearningProgress[]

  @@index([isoYear, isoWeek, deletedAt])
  @@index([studentTag, deletedAt])
  @@index([createdAt])
}

model DailyLearningAssignee {
  id               String            @id @default(cuid())
  planId           String
  plan             DailyLearningPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId           String
  user             User              @relation("DailyLearningAssigneeUser", fields: [userId], references: [id], onDelete: Restrict)
  usernameSnapshot String            @db.VarChar(50)
  realNameSnapshot String            @db.VarChar(50)
  labelSnapshot    String            @db.VarChar(200)
  createdAt        DateTime          @default(now())

  @@unique([planId, userId])
  @@index([userId, planId])
}

model DailyLearningProgress {
  id                       String            @id @default(cuid())
  planId                   String
  plan                     DailyLearningPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  userId                   String
  user                     User              @relation("DailyLearningProgressUser", fields: [userId], references: [id], onDelete: Restrict)
  learningDate             DateTime          @db.Date
  weekDay                  Int
  status                   String            @default("COMPLETED") @db.VarChar(20)
  contentSnapshot          String            @db.Text
  recordingR2StorageId     String?           @db.VarChar(191)
  recordingObjectKey       String?           @db.VarChar(1024)
  recordingOriginalName    String?           @db.VarChar(255)
  recordingMimeType        String?           @db.VarChar(100)
  recordingSize            Int?
  recordingDurationSeconds Int?
  completedAt              DateTime          @default(now())
  createdAt                DateTime          @default(now())

  @@unique([planId, userId, weekDay])
  @@index([planId, userId])
  @@index([userId, learningDate])
  @@index([recordingR2StorageId])
}

model DailyLearningSequence {
  dateKey   String   @id @db.VarChar(8)
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
}

model Notification {
  id              String                  @id @default(cuid())
  recordNo        String                  @unique @db.VarChar(12)
  clientRequestId String                  @unique @db.VarChar(64)
  title           String                  @db.VarChar(30)
  content         String                  @db.VarChar(500)
  type            NotificationType        @default(GENERAL)
  publishMode     NotificationPublishMode @default(SCHEDULED)
  releaseDate     DateTime                @db.Date
  releaseAt       DateTime
  publisherName   String                  @db.VarChar(10)
  showAfterLogin  Boolean                 @default(false)
  status          NotificationStatus      @default(PENDING)
  createdByUserId String?
  createdBy       User?                   @relation("NotificationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByName   String                  @db.VarChar(30)
  publishedAt     DateTime?
  stoppedAt       DateTime?
  stoppedByUserId String?
  stoppedByName   String?                 @db.VarChar(30)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  recipients      NotificationRecipient[]
  meeting         Meeting?

  @@index([status, releaseAt])
  @@index([createdByUserId, createdAt])
}

model NotificationRecipient {
  id               String       @id @default(cuid())
  notificationId   String
  notification     Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?        @relation("NotificationRecipientUser", fields: [userId], references: [id], onDelete: SetNull)
  usernameSnapshot String       @db.VarChar(30)
  realNameSnapshot String       @db.VarChar(30)
  roleSnapshot     String       @db.VarChar(50)
  readAt           DateTime?
  acknowledgedAt   DateTime?
  createdAt        DateTime     @default(now())

  @@unique([notificationId, userId])
  @@index([userId, notificationId])
  @@index([notificationId, readAt])
  @@index([userId, acknowledgedAt])
}

model NotificationSequence {
  dateKey   String   @id @db.VarChar(8)
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
}

model Meeting {
  id                          String                  @id @default(cuid())
  recordNo                    String                  @unique @db.VarChar(12)
  type                        MeetingType
  meetingMonth                DateTime                @db.Date
  notificationId              String                  @unique
  notification                Notification            @relation(fields: [notificationId], references: [id], onDelete: Restrict)
  notificationContentSnapshot String?                 @db.VarChar(500)
  notificationReleaseDate     DateTime?               @db.Date
  publisherNameSnapshot       String?                 @db.VarChar(10)
  attendanceStatus            MeetingAttendanceStatus @default(UNSIGNED)
  attendanceVersion           Int                     @default(0)
  checkedInByUserId           String?
  checkedInByName             String?                 @db.VarChar(30)
  checkedInAt                 DateTime?
  createdByUserId             String?
  createdBy                   User?                   @relation("MeetingCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByName               String                  @db.VarChar(30)
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  participants                MeetingParticipant[]

  @@index([type, meetingMonth])
  @@index([type, attendanceStatus])
  @@index([createdByUserId, createdAt])
}

model MeetingParticipant {
  id               String    @id @default(cuid())
  meetingId        String
  meeting          Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?     @relation("MeetingParticipantUser", fields: [userId], references: [id], onDelete: SetNull)
  usernameSnapshot String    @db.VarChar(30)
  realNameSnapshot String    @db.VarChar(30)
  roleSnapshot     String    @db.VarChar(50)
  attendedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@unique([meetingId, userId])
  @@index([userId, meetingId])
  @@index([meetingId, attendedAt])
}

model R2StorageConfig {
  id                       String               @id @default(cuid())
  recordNo                 String               @unique @db.VarChar(12)
  name                     String               @db.VarChar(20)
  accountId                String               @db.VarChar(50)
  accessKeyIdEncrypted     String               @db.Text
  secretAccessKeyEncrypted String               @db.Text
  bucketName               String               @db.VarChar(50)
  endpoint                 String               @db.VarChar(150)
  signedUrlExpireSeconds   Int                  @default(300)
  status                   RecordStatus         @default(ENABLED)
  version                  Int                  @default(1)
  createdByUserId          String?
  createdBy                User?                @relation("R2StorageCreator", fields: [createdByUserId], references: [id])
  references               R2StorageReference[]
  tests                    R2StorageTest[]
  tasks                    Task[]               @relation("TaskR2Storage")
  deletedAt                DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@index([accountId, bucketName])
  @@index([status])
  @@index([createdAt])
}

model R2StorageReference {
  id           String          @id @default(cuid())
  r2ConfigId   String
  r2Config     R2StorageConfig @relation(fields: [r2ConfigId], references: [id])
  businessType String          @db.VarChar(50)
  businessId   String          @db.VarChar(100)
  createdAt    DateTime        @default(now())

  @@unique([businessType, businessId])
  @@index([r2ConfigId])
}

model R2StorageTest {
  id              String          @id @default(cuid())
  r2ConfigId      String
  r2Config        R2StorageConfig @relation(fields: [r2ConfigId], references: [id])
  fileName        String          @db.VarChar(15)
  status          R2TestStatus    @default(PENDING)
  errorCode       String?         @db.VarChar(50)
  createdByUserId String?
  createdBy       User?           @relation("R2StorageTestCreator", fields: [createdByUserId], references: [id])
  createdAt       DateTime        @default(now())
  completedAt     DateTime?

  @@unique([r2ConfigId, fileName])
  @@index([createdAt])
}
