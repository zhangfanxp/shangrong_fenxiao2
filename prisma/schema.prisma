generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ENABLED
  DISABLED
}

enum UserType {
  SYSTEM
  CUSTOM
}

enum ContractStatus {
  PENDING
  ACTIVE
  EXPIRING
  TERMINATED
  EXPIRED
}

enum StoreOperationStatus {
  PREPARING
  TRIAL
  OPENING
  TERMINATING
  SUSPENDED
  CLOSED
}

enum CooperationType {
  DIRECT
  FRANCHISE
}

enum TaskType {
  DAILY
  WEEKLY
  MONTHLY
  TEMPORARY
  CALENDAR
}

enum TaskTarget {
  STORE
  STORE_EMPLOYEE
}

enum TaskRecordStatus {
  PENDING
  COMPLETED
  OVERDUE
}

enum BusinessDataSourceType {
  TASK_TEMPLATE
  ASSESSMENT_TEMPLATE
  RESEARCH_TEMPLATE
}

enum BusinessDataFieldType {
  INTEGER
  DECIMAL
  MONEY
  PERCENTAGE
  TEXT
  DATE
  DATETIME
}

enum BusinessDataFieldRole {
  DIMENSION
  METRIC
}

enum AssessmentScoreMode {
  BINARY
  CUSTOM_SCORE
}

enum R2TestStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PersonnelStatus {
  ACTIVE
  RESIGNED
}

enum DailyAttendanceType {
  FULL_ATTENDANCE
  REST
  LEAVE_FULL_DAY
  LEAVE_HOURS
}

enum SocialSecurityStatus {
  INSURED
  AGREEMENT
}

enum PlatformAccess {
  YES
  NO
}

enum BirthdayCalendar {
  LUNAR
  SOLAR
}

enum NotificationStatus {
  PENDING
  PUBLISHED
  STOPPED
  FAILED
}

enum NotificationType {
  GENERAL
  MID_MONTH_OFFLINE_MEETING
  MONTHLY_ONLINE_MEETING
  QUARTERLY_OFFLINE_MEETING
}

enum NotificationPublishMode {
  SCHEDULED
  IMMEDIATE
}

enum MeetingType {
  MID_MONTH_OFFLINE
  MONTHLY_ONLINE
  QUARTERLY_OFFLINE
}

enum MeetingAttendanceStatus {
  UNSIGNED
  SIGNED
}

enum CoursewareType {
  VIDEO
  AUDIO
  PDF
  PPT
}

enum InventoryManageStock {
  MANAGED
  UNMANAGED
}

enum InventoryBusinessType {
  INITIAL_STOCK
  PURCHASE_INBOUND
  EMPLOYEE_REQUISITION
  REQUISITION_RETURN
  MANUAL_ADJUSTMENT
}

enum InventoryDirection {
  IN
  OUT
}

enum ItemRequisitionStatus {
  NORMAL
  REVOKED
}

enum RestDayHolidayType {
  NEW_YEAR_DAY
  SPRING_FESTIVAL
  QINGMING_FESTIVAL
  LABOR_DAY
  DRAGON_BOAT_FESTIVAL
  MID_AUTUMN_FESTIVAL
  NATIONAL_DAY
  OTHER
}

enum StoreLaborAssessmentMetric {
  RECEIVED_AMOUNT
  ACTUAL_SALES_AMOUNT
}

enum StoreLaborRecordStatus {
  NORMAL
  OVERSTAFFED
  UNDERSTAFFED
  UNABLE_TO_CALCULATE
}

enum MonthlyPurchaseSalesSourceType {
  MANUAL
  IMPORT
}

model Role {
  id                String             @id @default(cuid())
  code              String             @unique
  name              String             @unique
  type              String             @default("SYSTEM")
  status            RecordStatus       @default(ENABLED)
  permissions       Json
  users             User[]
  assignedTasks     Task[]             @relation("TaskExecutorRole")
  taskExecutorRoles TaskExecutorRole[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model User {
  id                           String                            @id @default(cuid())
  username                     String                            @unique
  passwordHash                 String
  mustChangePassword           Boolean                           @default(false)
  realName                     String
  phone                        String?
  tags                         String?                           @db.VarChar(200)
  leadH5BrandIds               Json?
  leadH5StoreIds               Json?
  isRegionManager              Boolean                           @default(false)
  type                         UserType                          @default(CUSTOM)
  status                       RecordStatus                      @default(ENABLED)
  roleId                       String
  role                         Role                              @relation(fields: [roleId], references: [id])
  createdByUserId              String?
  createdBy                    User?                             @relation("UserCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdUsers                 User[]                            @relation("UserCreator")
  lastLoginAt                  DateTime?
  createdAt                    DateTime                          @default(now())
  updatedAt                    DateTime                          @updatedAt
  logs                         OperationLog[]
  createdTasks                 Task[]                            @relation("TaskCreator")
  createdTaskCalendarTemplates TaskCalendarTemplate[]            @relation("TaskCalendarTemplateCreator")
  createdAssessments           Assessment[]                      @relation("AssessmentCreator")
  createdResearchTemplates     ResearchTemplate[]                @relation("ResearchTemplateCreator")
  createdR2StorageConfigs      R2StorageConfig[]                 @relation("R2StorageCreator")
  r2StorageTests               R2StorageTest[]                   @relation("R2StorageTestCreator")
  personnelProfile             Personnel?                        @relation("PersonnelPlatformUser")
  createdPersonnel             Personnel[]                       @relation("PersonnelCreator")
  salaryAdjustments            SalaryHistory[]                   @relation("SalaryOperator")
  positionTransfers            PositionHistory[]                 @relation("PositionOperator")
  leadH5Reviews                LeadH5Review[]                    @relation("LeadH5Reviewer")
  leadH5ReviewPhotos           LeadH5ReviewPhoto[]               @relation("LeadH5ReviewPhotoUploader")
  leadH5ResearchRecords        ResearchTemplateRecord[]          @relation("LeadH5ResearchSubmitter")
  assignedTaskRecords          TaskRecord[]                      @relation("TaskRecordAssignee")
  taskSubmissions              TaskSubmission[]                  @relation("TaskSubmissionUser")
  taskAttachments              TaskAttachment[]                  @relation("TaskAttachmentUploader")
  analyzedTaskAiRecords        TaskAiAnalysis[]                  @relation("TaskAiAnalysisOperator")
  createdNotifications         Notification[]                    @relation("NotificationCreator")
  notificationRecipients       NotificationRecipient[]           @relation("NotificationRecipientUser")
  createdMeetings              Meeting[]                         @relation("MeetingCreator")
  meetingParticipants          MeetingParticipant[]              @relation("MeetingParticipantUser")
  createdDailyLearningPlans    DailyLearningPlan[]               @relation("DailyLearningPlanCreator")
  dailyLearningAssignments     DailyLearningAssignee[]           @relation("DailyLearningAssigneeUser")
  dailyLearningProgress        DailyLearningProgress[]           @relation("DailyLearningProgressUser")
  courseAssignments            CourseAssignment[]                @relation("CourseAssignmentUser")
  createdCourseAssignments     CourseAssignment[]                @relation("CourseAssignmentCreator")
  createdActualRevenue         ActualRevenueMonthly[]            @relation("ActualRevenueCreator")
  createdMonthlyTargets        StoreMonthlyTarget[]              @relation("MonthlyTargetCreator")
  createdInventoryItems        InventoryItem[]                   @relation("InventoryItemCreator")
  updatedInventoryItems        InventoryItem[]                   @relation("InventoryItemUpdater")
  inventoryTransactions        InventoryTransaction[]            @relation("InventoryTransactionOperator")
  createdItemRequisitions      ItemRequisition[]                 @relation("ItemRequisitionCreator")
  updatedItemRequisitions      ItemRequisition[]                 @relation("ItemRequisitionUpdater")
  itemRequisitionReturns       ItemRequisitionReturn[]           @relation("ItemRequisitionReturnOperator")
  createdDailyAttendances      DailyAttendanceRecord[]           @relation("DailyAttendanceCreator")
  updatedDailyAttendances      DailyAttendanceRecord[]           @relation("DailyAttendanceUpdater")
  dailyAttendanceRevisions     DailyAttendanceRevision[]         @relation("DailyAttendanceRevisionEditor")
  createdRestDays              RestDay[]                         @relation("RestDayCreator")
  updatedRestDays              RestDay[]                         @relation("RestDayUpdater")
  managedRegions               UserManagedRegion[]
  createdStoreLaborStandards   StoreLaborStandard[]              @relation("StoreLaborStandardCreator")
  updatedStoreLaborStandards   StoreLaborStandard[]              @relation("StoreLaborStandardUpdater")
  createdPurchaseSalesRatios   MonthlyPurchaseSalesRatio[]       @relation("MonthlyPurchaseSalesCreator")
  updatedPurchaseSalesRatios   MonthlyPurchaseSalesRatio[]       @relation("MonthlyPurchaseSalesUpdater")
  purchaseSalesImportBatches   MonthlyPurchaseSalesImportBatch[] @relation("MonthlyPurchaseSalesImportOperator")
  createdProductCategorySales  ProductCategorySalesMonthly[]     @relation("ProductCategorySalesCreator")
  updatedProductCategorySales  ProductCategorySalesMonthly[]     @relation("ProductCategorySalesUpdater")
  productCategorySalesBatches  ProductCategorySalesImportBatch[] @relation("ProductCategorySalesImportOperator")

  @@index([createdByUserId])
  @@index([lastLoginAt])
}

model UserManagedRegion {
  userId    String   @db.VarChar(191)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  region    String   @db.VarChar(191)
  createdAt DateTime @default(now())

  @@id([userId, region])
  @@unique([region])
}

model Assessment {
  id                   String                 @id @default(cuid())
  recordNo             String                 @unique
  name                 String
  scoreMode            AssessmentScoreMode    @default(BINARY)
  configFileName       String                 @unique
  applicableBrands     Json?
  r2StorageId          String                 @db.VarChar(191)
  r2Storage            R2StorageConfig        @relation("AssessmentR2Storage", fields: [r2StorageId], references: [id])
  photoAttachmentLimit Int                    @default(3)
  nonFullScoreRequiresPhoto Boolean           @default(false)
  failRequiresProblemDescription Boolean      @default(false)
  partialRequiresProblemDescription Boolean  @default(false)
  detailText           String                 @db.LongText
  sectionCount         Int
  subsectionCount      Int
  itemCount            Int
  totalScore           Decimal                @db.Decimal(10, 1)
  remark               String?                @db.VarChar(50)
  status               RecordStatus           @default(ENABLED)
  configVersion        Int                    @default(1)
  createdByUserId      String?
  createdBy            User?                  @relation("AssessmentCreator", fields: [createdByUserId], references: [id])
  deletedAt            DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  records              AssessmentRecord[]
  leadH5Reviews        LeadH5Review[]
  brandScopes          AssessmentBrandScope[]

  @@index([createdAt])
  @@index([status])
  @@index([r2StorageId])
}

model AssessmentBrandScope {
  id             String     @id @default(cuid())
  assessmentId   String
  assessment     Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  brandValue     String     @db.VarChar(100)
  assessmentType String     @db.VarChar(100)
  activeKey      String?    @unique @db.VarChar(64)

  @@unique([assessmentId, brandValue])
  @@index([brandValue, assessmentType])
}

model AssessmentRecord {
  id               String     @id @default(cuid())
  assessmentId     String
  assessment       Assessment @relation(fields: [assessmentId], references: [id])
  configVersion    Int
  configSnapshot   Json
  scoreSnapshot    Json?
  actualTotalScore Decimal?   @db.Decimal(10, 1)
  createdAt        DateTime   @default(now())

  @@index([assessmentId])
}

model ResearchTemplate {
  id              String                   @id @default(cuid())
  recordNo        String                   @unique @db.VarChar(12)
  templateType    String                   @db.VarChar(100)
  configFileName  String                   @unique @db.VarChar(25)
  detailText      String                   @db.LongText
  itemCount       Int
  remark          String?                  @db.VarChar(50)
  status          RecordStatus             @default(ENABLED)
  configVersion   Int                      @default(1)
  createdByUserId String?
  createdBy       User?                    @relation("ResearchTemplateCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByName   String                   @db.VarChar(50)
  deletedAt       DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  brandScopes     ResearchTemplateBrand[]
  records         ResearchTemplateRecord[]

  @@index([templateType])
  @@index([status])
  @@index([createdAt])
}

model ResearchTemplateBrand {
  id                 String           @id @default(cuid())
  researchTemplateId String
  researchTemplate   ResearchTemplate @relation(fields: [researchTemplateId], references: [id], onDelete: Cascade)
  brandValue         String           @db.VarChar(100)

  @@unique([researchTemplateId, brandValue])
  @@index([brandValue])
}

model ResearchTemplateRecord {
  id                       String           @id @default(cuid())
  recordNo                 String           @unique @db.VarChar(12)
  researchMonth            String           @db.VarChar(7)
  templateType             String           @db.VarChar(100)
  status                   String           @default("SUBMITTED") @db.VarChar(20)
  storeId                  String
  store                    Store            @relation(fields: [storeId], references: [id])
  storeNameSnapshot        String           @db.VarChar(100)
  brandId                  String
  brandNameSnapshot        String           @db.VarChar(100)
  storeManagerNameSnapshot String?          @db.VarChar(50)
  submittedByUserId        String
  submittedBy              User             @relation("LeadH5ResearchSubmitter", fields: [submittedByUserId], references: [id])
  submittedUsername        String           @db.VarChar(50)
  supervisorRealName       String           @db.VarChar(50)
  researchTemplateId       String
  researchTemplate         ResearchTemplate @relation(fields: [researchTemplateId], references: [id])
  researchTemplateRecordNo String           @db.VarChar(12)
  configVersion            Int
  configSnapshot           Json
  resultSnapshot           Json
  submittedAt              DateTime         @db.DateTime(0)
  createdAt                DateTime         @default(now())

  @@unique([storeId, researchMonth, templateType])
  @@index([researchTemplateId])
  @@index([researchMonth, templateType])
  @@index([submittedByUserId])
}

model BusinessDataSource {
  id                       String                    @id @default(cuid())
  recordNo                 String                    @unique @db.VarChar(12)
  businessName             String                    @db.VarChar(20)
  sourceType               BusinessDataSourceType
  templateId               String                    @db.VarChar(191)
  templateRecordNoSnapshot String                    @db.VarChar(24)
  templateNameSnapshot     String                    @db.VarChar(100)
  systemSources            Json?
  remark                   String?                   @db.VarChar(200)
  createdByUserId          String                    @db.VarChar(191)
  createdByUsername        String                    @db.VarChar(50)
  createdByNameSnapshot    String                    @db.VarChar(50)
  updatedByUserId          String?                   @db.VarChar(191)
  updatedByNameSnapshot    String?                   @db.VarChar(50)
  version                  Int                       @default(1)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  fields                   BusinessDataSourceField[]

  @@index([sourceType, templateId], map: "BusinessDataSource_sourceType_templateId_idx")
  @@index([businessName])
  @@index([templateRecordNoSnapshot])
  @@index([createdAt, id])
}

model BusinessDataSourceField {
  id                   String                @id @default(cuid())
  businessDataSourceId String
  businessDataSource   BusinessDataSource    @relation(fields: [businessDataSourceId], references: [id], onDelete: Cascade)
  sourceFieldKey       String                @db.VarChar(191)
  sourceFieldId        String?               @db.VarChar(191)
  sourceFieldCode      String?               @db.VarChar(191)
  fieldNameSnapshot    String                @db.VarChar(200)
  sourceFieldType      String?               @db.VarChar(50)
  sourceFieldConfig    Json?
  fieldRole            BusinessDataFieldRole @default(METRIC)
  fieldType            BusinessDataFieldType
  unit                 String?               @db.VarChar(10)
  remark               String?               @db.VarChar(200)
  sortOrder            Int
  createdByUserId      String                @db.VarChar(191)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([businessDataSourceId, sourceFieldKey], map: "BusinessDSField_source_field_key")
  @@unique([businessDataSourceId, fieldNameSnapshot], map: "BusinessDSField_field_name_key")
  @@index([businessDataSourceId, sortOrder], map: "BusinessDSField_source_sort_idx")
}

model BusinessDataSourceSequence {
  dateKey   String   @id @db.VarChar(8)
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
}

model LeadH5ResearchSequence {
  dateKey   String   @id @db.VarChar(8)
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
}

model Brand {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String       @unique
  status    RecordStatus @default(ENABLED)
  contracts Contract[]
  stores    Store[]
  taskLinks TaskBrand[]
  createdAt DateTime     @default(now())
}

model Contract {
  id                String           @id @default(cuid())
  recordNo          String           @unique
  brandId           String
  brand             Brand            @relation(fields: [brandId], references: [id])
  storeName         String
  status            ContractStatus   @default(PENDING)
  archiveBox        String?
  trialOpenDate     DateTime?
  cooperationType   CooperationType
  contactName       String?
  contactPhone      String?
  ownerName         String
  ownerPhone        String?
  ownerIdNumber     String?
  province          String?
  city              String?
  district          String?
  address           String?
  cooperationFee    Decimal          @default(0) @db.Decimal(12, 2)
  brandFee          Decimal          @default(0) @db.Decimal(12, 2)
  financeServiceFee Decimal          @default(0) @db.Decimal(12, 2)
  designFee         Decimal          @default(0) @db.Decimal(12, 2)
  deposit           Decimal          @default(0) @db.Decimal(12, 2)
  depositRecipient  String?
  refundedDeposit   Decimal          @default(0) @db.Decimal(12, 2)
  rebateType        String?
  rebatePerson      String?
  rebateAmount      Decimal          @default(0) @db.Decimal(12, 2)
  startDate         DateTime
  endDate           DateTime
  remark            String?          @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  store             Store?
  rebates           ContractRebate[]

  @@index([status, endDate])
}

model ContractRebate {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  type       String
  person     String
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([contractId])
}

model Store {
  id                          String                        @id @default(cuid())
  recordNo                    String                        @unique
  contractId                  String?                       @unique
  contract                    Contract?                     @relation(fields: [contractId], references: [id])
  brandId                     String
  brand                       Brand                         @relation(fields: [brandId], references: [id])
  name                        String
  operationStatus             StoreOperationStatus          @default(PREPARING)
  region                      String?
  supervisorUserId            String?                       @db.VarChar(191)
  supervisorName              String?
  province                    String?
  city                        String?
  district                    String?
  address                     String?
  cooperationType             CooperationType
  startDate                   DateTime?
  endDate                     DateTime?
  businessDistrict            String?
  locationType                String?
  trialOpenDate               DateTime?
  formalOpenDate              DateTime?
  workdayHours                Decimal?                      @db.Decimal(5, 2)
  partTimeLaborCost           Decimal?                      @db.Decimal(12, 2)
  managerUserId               String?                       @db.VarChar(191)
  managerName                 String?
  chefUserId                  String?                       @db.VarChar(191)
  chefName                    String?
  douyinLaikeName             String?                       @db.VarChar(50)
  kuaishouName                String?                       @db.VarChar(50)
  meituanManagerName          String?                       @db.VarChar(50)
  meituanBusinessName         String?                       @db.VarChar(50)
  ownerName                   String?
  ownerPhone                  String?
  ownerIdNumber               String?
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  personnel                   Personnel[]
  leadH5Reviews               LeadH5Review[]
  leadH5ResearchRecords       ResearchTemplateRecord[]
  taskRecords                 TaskRecord[]
  taskSubmissions             TaskSubmission[]
  actualRevenueMonthly        ActualRevenueMonthly[]
  actualRevenueDaily          ActualRevenueDaily[]
  monthlyTargets              StoreMonthlyTarget[]
  dailyTargets                StoreDailyTarget[]
  dailyAttendanceRecords      DailyAttendanceRecord[]
  laborRecords                StoreLaborRecord[]
  costProfile                 StoreCost?
  monthlyPurchaseSalesRatios  MonthlyPurchaseSalesRatio[]
  productCategorySalesMonthly ProductCategorySalesMonthly[]

  @@index([supervisorUserId])
}

model MonthlyPurchaseSalesRatio {
  id                             String                           @id @default(cuid())
  recordNo                       String                           @unique @db.VarChar(12)
  storeId                        String
  store                          Store                            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  storeNameSnapshot              String                           @db.VarChar(100)
  aliasId                        String                           @db.VarChar(191)
  meituanAliasSnapshot           String                           @db.VarChar(50)
  brandCode                      String                           @db.VarChar(50)
  brandNameSnapshot              String                           @db.VarChar(100)
  year                           Int                              @db.SmallInt
  month                          Int                              @db.TinyInt
  preDiscountSales               Decimal                          @db.Decimal(18, 2)
  postDiscountSales              Decimal?                         @db.Decimal(18, 2)
  purchaseAmount                 Decimal                          @db.Decimal(18, 2)
  preDiscountPurchaseSalesRatio  Decimal                          @db.Decimal(10, 4)
  postDiscountPurchaseSalesRatio Decimal?                         @db.Decimal(10, 4)
  remark                         String?                          @db.VarChar(200)
  sourceType                     MonthlyPurchaseSalesSourceType
  lastImportBatchId              String?
  lastImportBatch                MonthlyPurchaseSalesImportBatch? @relation(fields: [lastImportBatchId], references: [id], onDelete: SetNull)
  createdByUserId                String?
  createdBy                      User?                            @relation("MonthlyPurchaseSalesCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByUsername              String                           @db.VarChar(50)
  createdByNameSnapshot          String                           @db.VarChar(50)
  updatedByUserId                String?
  updatedBy                      User?                            @relation("MonthlyPurchaseSalesUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  updatedByNameSnapshot          String?                          @db.VarChar(50)
  createdAt                      DateTime                         @default(now())
  updatedAt                      DateTime                         @updatedAt

  @@unique([storeId, year, month])
  @@index([year, month, storeNameSnapshot])
  @@index([brandCode, year, month])
  @@index([lastImportBatchId])
}

model MonthlyPurchaseSalesSequence {
  dateKey   String   @id @db.VarChar(8)
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
}

model MonthlyPurchaseSalesImportBatch {
  id                   String                              @id @default(cuid())
  batchNo              String                              @unique @db.VarChar(24)
  fileName             String                              @db.VarChar(255)
  year                 Int                                 @db.SmallInt
  month                Int                                 @db.TinyInt
  periodStart          DateTime                            @db.Date
  periodEnd            DateTime                            @db.Date
  totalCount           Int
  insertedCount        Int                                 @default(0)
  updatedCount         Int                                 @default(0)
  skippedCount         Int                                 @default(0)
  failedCount          Int                                 @default(0)
  operatorUserId       String?
  operator             User?                               @relation("MonthlyPurchaseSalesImportOperator", fields: [operatorUserId], references: [id], onDelete: SetNull)
  operatorNameSnapshot String                              @db.VarChar(50)
  createdAt            DateTime                            @default(now())
  records              MonthlyPurchaseSalesRatio[]
  failures             MonthlyPurchaseSalesImportFailure[]

  @@index([year, month, createdAt])
  @@index([operatorUserId, createdAt])
}

model MonthlyPurchaseSalesImportFailure {
  id            String                          @id @default(cuid())
  batchId       String
  batch         MonthlyPurchaseSalesImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  excelRowNo    Int
  storeAlias    String?                         @db.VarChar(100)
  failureReason String                          @db.VarChar(255)
  createdAt     DateTime                        @default(now())

  @@index([batchId, excelRowNo])
}

model ProductCategorySalesMonthly {
  id                    String                           @id @default(cuid())
  recordNo              String                           @unique @db.VarChar(12)
  year                  Int                              @db.SmallInt
  month                 Int                              @db.TinyInt
  storeId               String
  store                 Store                            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  storeNameSnapshot     String                           @db.VarChar(100)
  aliasId               String                           @db.VarChar(191)
  meituanAliasSnapshot  String                           @db.VarChar(100)
  brandCode             String                           @db.VarChar(50)
  brandNameSnapshot     String                           @db.VarChar(100)
  citySnapshot          String                           @db.VarChar(100)
  totalSalesQuantity    Decimal                          @db.Decimal(18, 2)
  totalSalesAmount      Decimal                          @db.Decimal(18, 2)
  lastImportBatchId     String?
  lastImportBatch       ProductCategorySalesImportBatch? @relation(fields: [lastImportBatchId], references: [id], onDelete: SetNull)
  createdByUserId       String?
  createdBy             User?                            @relation("ProductCategorySalesCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByUsername     String                           @db.VarChar(50)
  createdByNameSnapshot String                           @db.VarChar(50)
  updatedByUserId       String?
  updatedBy             User?                            @relation("ProductCategorySalesUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  updatedByNameSnapshot String?                          @db.VarChar(50)
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt
  details               ProductCategorySalesDetail[]

  @@unique([storeId, year, month])
  @@index([year, month, storeNameSnapshot])
  @@index([brandCode, year, month])
  @@index([lastImportBatchId])
}

model ProductCategorySalesDetail {
  id                 String                      @id @default(cuid())
  monthlyRecordId    String
  monthlyRecord      ProductCategorySalesMonthly @relation(fields: [monthlyRecordId], references: [id], onDelete: Cascade)
  categoryName       String                      @db.VarChar(100)
  salesQuantity      Decimal                     @db.Decimal(18, 2)
  salesQuantityRatio Decimal?                    @db.Decimal(10, 4)
  salesAmount        Decimal                     @db.Decimal(18, 2)
  salesAmountRatio   Decimal?                    @db.Decimal(10, 4)
  dishIncome         Decimal                     @db.Decimal(18, 2)
  dishIncomeRatio    Decimal?                    @db.Decimal(10, 4)
  dishDiscount       Decimal                     @db.Decimal(18, 2)
  dishDiscountRatio  Decimal?                    @db.Decimal(10, 4)
  sortOrder          Int
  createdAt          DateTime                    @default(now())

  @@unique([monthlyRecordId, categoryName])
